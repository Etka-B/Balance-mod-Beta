						position = { 550 0 }
						size = { 150 26 }
						text = "BALANCE_COLONY_SEARCH"
						tooltip = "BALANCE_COLONY_SEARCH_TT"
						onclick = "[OnFindLocation]"
					}
				}
				widget = {
					size = { 700 36 }
					background = { using = color_black_texture alpha = 0.3 }
					text_single = {
						position = { 8 9 }
						size = { 70 18 }
						autoresize = no
						align = left|nobaseline
						fontsize = 12
						text = "BALANCE_COLONY_GOODS_LABEL"
						default_format = "#weak"
					}
					text_single = {
						visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('balance_colony_goods'))]"
