						onclick = "[GetScriptedGui('balance_colony_select_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
					button_regular_alt = {
						visible = "[Not(Not(IsDataModelEmpty(GetPlayer.MakeScope.GetList('balance_colony_selected'))))]"
