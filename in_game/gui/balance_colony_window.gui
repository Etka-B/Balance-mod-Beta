# THE COLONY WINDOW. Opened by the "Colonies" tab button in the right panel's
# tab row (panels/right_panel/right_panel.gui) and by the small button in the
# location window (location_window.gui); made live by
# gui/scripted_widgets/balance_scripted_windows.txt. Its buttons and lists are
# common/scripted_guis/balance_colony_gui.txt and balance_colony_prio_gui.txt.
# Written by scripts (the tabs: colony_v9.py).

window = {
	name = "balance_colony_window"
	parentanchor = top|hcenter
	widgetanchor = top|hcenter
	position = { 0 70 }
	size = { 1497 850 }
	allow_outside = yes
	movable = yes
	visible = "[GetVariableSystem.Exists('balance_colony_open')]"
	using = bg_main_inner_alt

	# ESC closes it, as the game's own popups do (close_window input action)
	button_regular = {
		visible = "[Not(GetVariableSystem.Exists('balance_colony_tab'))]"
		position = { 15 11 }
		size = { 32 32 }
		fontsize = 17
		fontsize_min = 10
		raw_text = "?"
		tooltip = "BALANCE_COLONY_HELP"
	}
	button_regular = {
		visible = "[GetVariableSystem.HasValue('balance_colony_tab', 'prio')]"
		position = { 15 11 }
		size = { 32 32 }
		fontsize = 17
		fontsize_min = 10
		raw_text = "?"
		tooltip = "BALANCE_PRIO_HELP"
	}
	button_regular = {
		visible = "[GetVariableSystem.HasValue('balance_colony_tab', 'third')]"
		position = { 15 11 }
		size = { 32 32 }
		fontsize = 17
		fontsize_min = 10
		raw_text = "?"
		tooltip = "BALANCE_ASSIGN_HELP"
	}

	button_close = {
		parentanchor = top|right
		position = { -11 9 }
		blockoverride "close_title" {
			title = "BALANCE_COLONY_CLOSE_TT"
		}
		blockoverride "close_on_action" {
			on_action = "[GetVariableSystem.Clear('balance_colony_open')]"
			on_action = "[GetVariableSystem.Clear('balance_send')]"
			on_action = "[GetVariableSystem.Clear('balance_lp')]"
		}
	}

	vbox = {
		using = layoutpolicy_expanding
		margin = { 17 9 }
		spacing = 9

		window_header_alt = {
			blockoverride "header_text" {
				text = "BALANCE_COLONY_TITLE"
			}
			blockoverride "window_header_alt_color_texture" {
				using = color_default_brown_texture
			}
			blockoverride "bg_top_header_graphical_culture_pattern" {}
		}

		header_main_tabs = {
			size = { 1462 49 }
			blockoverride "content" {
				button_main_tab_alt = {
					using = layoutpolicy_expanding
					blockoverride "tab_text" {
						text = "BALANCE_COLONY_TAB_MGMT"
					}
					down = "[Not(GetVariableSystem.Exists('balance_colony_tab'))]"
					onclick = "[GetVariableSystem.Clear('balance_colony_tab')]"
				}
				button_main_tab_alt = {
					using = layoutpolicy_expanding
					blockoverride "tab_text" {
						text = "BALANCE_COLONY_TAB_PRIO"
					}
					down = "[GetVariableSystem.HasValue('balance_colony_tab', 'prio')]"
					onclick = "[GetVariableSystem.Set('balance_colony_tab', 'prio')]"
					onclick = "[GetScriptedGui('balance_prio_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				button_main_tab_alt = {
					using = layoutpolicy_expanding
					blockoverride "tab_text" {
						text = "BALANCE_COLONY_TAB_THIRD"
					}
					down = "[GetVariableSystem.HasValue('balance_colony_tab', 'third')]"
					onclick = "[GetVariableSystem.Set('balance_colony_tab', 'third')]"
					onclick = "[GetScriptedGui('balance_assign_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
		}


		hbox = {
			visible = "[Not(GetVariableSystem.HasValue('balance_colony_tab', 'third'))]"
			spacing = 13
			vbox = {
				spacing = 4
				widget = {
					size = { 270 37 }
					using = bg_card_header_01_production
					widget = {
						size = { 100% 100% }
						text_single = {
							fontsize = 16
							fontsize_min = 10
							position = { 11 8 }
							size = { 151 24 }
							autoresize = no
							align = left|nobaseline
							text = "BALANCE_COLONY_SUBJECTS"
						using = Font_Type_Headers
						}
						button_regular = {
							fontsize = 15
							fontsize_min = 10
							position = { 171 4 }
							size = { 91 28 }
							text = "BALANCE_COLONY_REFRESH"
							onclick = "[GetScriptedGui('balance_colony_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}
				widget = {
					size = { 270 661 }
					using = bg_secondary_inner_alt
					text_multi = {
						fontsize = 16
						fontsize_min = 10
						visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('balance_colony_subjects'))]"
						position = { 13 13 }
						size = { 244 130 }
						autoresize = no
						text = "BALANCE_COLONY_NO_SUBJECTS"
					}
					scrollarea = {
						size = { 100% 100% }
						scrollbarpolicy_horizontal = always_off
						scrollbar_vertical = { using = Scrollbar_Vertical }
						scrollwidget = {
							fixedgridbox = {
								addcolumn = 253
								addrow = 45
								setitemsizefromcell = yes
								datamodel = "[GetPlayer.MakeScope.GetList('balance_colony_subjects')]"
								item = {
									widget = {
										size = { 253 43 }
										using = bg_scroll_card
										background = {
											visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
											using = color_black_texture
											alpha = 0.25
										}
										background = {
											visible = "[GetScriptedGui('balance_colony_is_subject').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('subject', Scope.GetCountry.MakeScope).End)]"
											using = color_default_brown_texture
											alpha = 0.85
										}
										country_flag_small = {
											position = { 9 9 }
											datacontext = "[Scope.GetCountry]"
										}
										text_single = {
											fontsize = 16
											fontsize_min = 10
											position = { 56 4 }
											size = { 188 19 }
											autoresize = no
											align = left|nobaseline
											text = "[Scope.GetCountry.GetNameWithNoTooltip]"
											default_format = "#yellow_titles"
										}
										text_single = {
											position = { 56 23 }
											size = { 188 17 }
											autoresize = no
											align = left|nobaseline
											fontsize = 13
											fontsize_min = 10
											datacontext = "[Scope.GetCountry]"
											text = "BALANCE_COLONY_LOC_COUNT"
										}
										button = {
											size = { 100% 100% }
											onclick = "[GetScriptedGui('balance_colony_pick_subject').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('subject', Scope.GetCountry.MakeScope).End)]"
										}
									}
								}
							}
						}
					}
				}
			}
			widget = {
