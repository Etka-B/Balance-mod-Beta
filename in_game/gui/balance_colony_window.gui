# THE COLONY WINDOW. Opened by the "Colonies" tab button in the right panel's
# tab row (panels/right_panel/right_panel.gui) and by the small button in the
# location window (location_window.gui); made live by
# gui/scripted_widgets/balance_scripted_windows.txt. Its buttons and lists are
# common/scripted_guis/balance_colony_gui.txt. Written by a script.

window = {
	name = "balance_colony_window"
	parentanchor = top|hcenter
	widgetanchor = top|hcenter
	position = { 0 96 }
	size = { 1386 800 }
	allow_outside = yes
	movable = yes
	visible = "[GetVariableSystem.Exists('balance_colony_open')]"
	using = bg_main_inner_alt

	# ESC closes it, as the game's own popups do (close_window input action)
	button_close = {
		parentanchor = top|right
		position = { -10 8 }
		blockoverride "close_title" {
			title = "BALANCE_COLONY_CLOSE_TT"
		}
		blockoverride "close_on_action" {
			on_action = "[GetVariableSystem.Clear('balance_colony_open')]"
		}
	}

	vbox = {
		using = layoutpolicy_expanding
		margin = { 16 8 }
		spacing = 8

		window_header_alt = {
			blockoverride "header_text" {
				text = "BALANCE_COLONY_TITLE"
			}
		}

		hbox = {
			spacing = 12
			vbox = {
				spacing = 4
				widget = {
					size = { 250 34 }
					background = { using = color_black_texture alpha = 0.55 }
					widget = {
						size = { 100% 100% }
						text_single = {
							position = { 10 7 }
							size = { 140 22 }
							autoresize = no
							align = left|nobaseline
							text = "BALANCE_COLONY_SUBJECTS"
						using = Font_Type_Headers
						}
						button_regular_alt = {
							position = { 158 4 }
							size = { 84 26 }
							text = "BALANCE_COLONY_REFRESH"
							tooltip = "BALANCE_COLONY_REFRESH_TT"
							onclick = "[GetScriptedGui('balance_colony_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}
				widget = {
					size = { 250 612 }
					background = { using = color_black_texture alpha = 0.3 }
					text_multi = {
						visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('balance_colony_subjects'))]"
						position = { 12 12 }
						size = { 226 120 }
						autoresize = no
						text = "BALANCE_COLONY_NO_SUBJECTS"
					}
					scrollarea = {
						size = { 100% 100% }
						scrollbarpolicy_horizontal = always_off
						scrollbar_vertical = { using = Scrollbar_Vertical }
						scrollwidget = {
							fixedgridbox = {
								addcolumn = 234
								addrow = 42
								setitemsizefromcell = yes
								datamodel = "[GetPlayer.MakeScope.GetList('balance_colony_subjects')]"
								item = {
									widget = {
										size = { 234 40 }
										background = { using = color_black_texture alpha = 0.45 }
										background = {
											visible = "[IsOdd_int32(PdxGuiWidget.GetIndexInDataModel)]"
											using = color_black_texture
											alpha = 0.25
										}
										background = {
											visible = "[GetScriptedGui('balance_colony_is_subject').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('subject', Scope.GetCountry.MakeScope).End)]"
											using = color_default_brown_texture
											alpha = 0.85
										}
										country_flag_small = {
											position = { 8 8 }
											datacontext = "[Scope.GetCountry]"
										}
										text_single = {
											position = { 52 4 }
											size = { 174 18 }
											autoresize = no
											align = left|nobaseline
											text = "[Scope.GetCountry.GetNameWithNoTooltip]"
											default_format = "#yellow_titles"
										}
										text_single = {
											position = { 52 21 }
											size = { 174 16 }
											autoresize = no
											align = left|nobaseline
											fontsize = 12
											datacontext = "[Scope.GetCountry]"
											text = "BALANCE_COLONY_LOC_COUNT"
										}
										button = {
											size = { 100% 100% }
											tooltip = "BALANCE_COLONY_PICK_SUBJECT_TT"
											onclick = "[GetScriptedGui('balance_colony_pick_subject').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('subject', Scope.GetCountry.MakeScope).End)]"
										}
									}
								}
							}
						}
					}
				}
			}
			vbox = {
				spacing = 4
				widget = {
					size = { 700 34 }
					background = { using = color_black_texture alpha = 0.55 }
					widget = {
						size = { 100% 100% }
						country_flag_small = {
							visible = "[GetPlayer.MakeScope.GetVariable('balance_colony_subject').IsSet]"
							position = { 8 5 }
							datacontext = "[GetPlayer.MakeScope.GetVariable('balance_colony_subject').GetCountry]"
						}
						text_single = {
							visible = "[GetPlayer.MakeScope.GetVariable('balance_colony_subject').IsSet]"
							position = { 52 7 }
							size = { 360 22 }
							autoresize = no
							align = left|nobaseline
							text = "[GetPlayer.MakeScope.GetVariable('balance_colony_subject').GetCountry.GetNameWithNoTooltip]"
							using = Font_Type_Headers
						}
						text_single = {
							visible = "[Not(GetPlayer.MakeScope.GetVariable('balance_colony_subject').IsSet)]"
							position = { 10 7 }
							size = { 360 22 }
							autoresize = no
							align = left|nobaseline
							text = "BALANCE_COLONY_PICK_SUBJECT"
							using = Font_Type_Headers
						}
						text_single = {
							visible = "[GetPlayer.MakeScope.GetVariable('balance_colony_subject').IsSet]"
							position = { 420 9 }
							size = { 270 18 }
							autoresize = no
							align = right|nobaseline
							fontsize = 12
							text = "BALANCE_COLONY_COUNTS"
						}
					}
				}
				widget = {
					size = { 700 26 }
					widget = {
						position = { 0 0 }
						size = { 92 26 }
						button_regular_alt_green = {
							visible = "[GetScriptedGui('balance_colony_filter_all_on').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							size = { 92 26 }
							text = "BALANCE_COLONY_F_ALL"
							tooltip = "BALANCE_COLONY_F_ALL_TT"
							onclick = "[GetScriptedGui('balance_colony_filter_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_regular_alt = {
