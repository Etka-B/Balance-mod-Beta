						size = { 600 20 }
						autoresize = no
						align = left|nobaseline
						text = "BALANCE_COLONY_GOODS_NONE"
						default_format = "#weak"
					}
					# a fixed, clipped holder: a bare hbox stretches to its parent and centres
					widget = {
						position = { 80 2 }
						size = { 616 32 }
						scissor = yes
						hbox = {
							size = { 100% 100% }
							hbox = {
								spacing = 2
								datamodel = "[GetPlayer.MakeScope.GetList('balance_colony_goods')]"
								item = {
									widget = {
										size = { 32 32 }
										background = {
											visible = "[GetScriptedGui('balance_colony_is_goods').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('goods', Scope.GetGoods.MakeScope).End)]"
											using = color_default_brown_texture
											alpha = 0.95
										}
										icon = {
											position = { 3 3 }
											size = { 26 26 }
											texture = "[GetGoodsIcon(Scope.GetGoods.Self)]"
										}
										button = {
											size = { 100% 100% }
											tooltip = "BALANCE_COLONY_GOODS_TT"
											onclick = "[GetScriptedGui('balance_colony_filter_goods').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('goods', Scope.GetGoods.MakeScope).End)]"
										}
									}
								}
							}
							expand = {}
						}
					}
				}
