												size = { 100% 100% }
												onclick = "[GetScriptedGui('balance_lp_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('location', Scope.GetLocation.MakeScope).End)]"
											}
											button = {
												visible = "[Not(GetScriptedGui('balance_lp_toggle_on').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('location', Scope.GetLocation.MakeScope).End))]"
												size = { 100% 100% }
												onclick = "[GetScriptedGui('balance_lp_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('location', Scope.GetLocation.MakeScope).End)]"
											}
