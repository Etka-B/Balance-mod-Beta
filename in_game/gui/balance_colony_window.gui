												down = "[GetScriptedGui('balance_lp_toggle_on').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('location', Scope.GetLocation.MakeScope).End)]"
												alwaystransparent = yes
											}
											text_single = {
												visible = "[GetScriptedGui('balance_lp_toggle_on').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('location', Scope.GetLocation.MakeScope).End)]"
