						button_regular_alt_green = {
							visible = "[GetScriptedGui('balance_colony_filter_city_on').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							size = { 92 26 }
							text = "BALANCE_COLONY_F_CITY"
							tooltip = "BALANCE_COLONY_F_RANK_TT"
							onclick = "[GetScriptedGui('balance_colony_filter_city').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_regular_alt = {
							visible = "[Not(GetScriptedGui('balance_colony_filter_city_on').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
